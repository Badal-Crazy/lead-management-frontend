// ---------- API Configuration ----------
// CHANGE THIS TO YOUR CUSTOM IP
// Example: http://192.168.1.100:8080
export const CUSTOM_IP = 'YOUR_IP_ADDRESS';
// Development URL
export const DEV_API_BASE_URL = 'http://localhost:8080';

// Production URL with Custom IP
export const PROD_API_BASE_URL = `http://${CUSTOM_IP}:8080`;

// Use environment variable or fallback to custom IP
export const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || PROD_API_BASE_URL;
export const API_URL = `${API_BASE_URL}/api`;

// ---------- Frontend Configuration ----------
export const FRONTEND_URL = import.meta.env.VITE_FRONTEND_URL || `http://${CUSTOM_IP}:5173`;
export const APP_NAME = 'Master CRM';
export const APP_VERSION = '2.0.0';

// ---------- Authentication ----------
export const AUTH = {
  tokenKey: 'token',
  userKey: 'user',
  refreshTokenKey: 'refreshToken',
};

// ---------- API Endpoints ----------
export const ENDPOINTS = {
  AUTH: {
    LOGIN: '/auth/login',
    LOGOUT: '/auth/logout',
    SIGNUP: '/auth/signup',
  },
  ADMIN: {
    STATS: '/admin/stats',
    USERS: '/admin/users',
    DELETE_USER: '/admin/users',
  },
  LEADS: {
    GET: '/leads',
    UPLOAD: '/leads/upload',
    SEARCH: '/leads/search',
  },
  DISPOSITIONS: {
    GET: '/dispositions',
    CREATE: '/dispositions',
  },
};

// ---------- Default Values ----------
export const DEFAULTS = {
  pageSize: 10,
  maxFileSize: 50 * 1024 * 1024,
  apiTimeout: 30000,
};

export default {
  CUSTOM_IP,
  API_BASE_URL,
  API_URL,
  FRONTEND_URL,
  APP_NAME,
  APP_VERSION,
  AUTH,
  ENDPOINTS,
  DEFAULTS,
};
